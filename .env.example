# Haularr environment configuration
# Copy to .env and adjust values

# Config directory (SQLite DB, master key, admin env)
HAULARR_CONFIG_DIR=/config

# Server
HAULARR_HOST=0.0.0.0
HAULARR_PORT=8080

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HAULARR_SECRET_KEY=change-me-in-production-use-32-chars-min
HAULARR_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin account (set via /api/v1/auth/setup on first run)
HAULARR_ADMIN_USERNAME=admin
# HAULARR_ADMIN_PASSWORD_HASH is set by the setup endpoint, not manually

# Logging
HAULARR_LOG_LEVEL=INFO

# Static frontend directory (built SvelteKit output)
HAULARR_STATIC_DIR=frontend/build

# Scheduler/Concurrency defaults
HAULARR_MAX_CONCURRENT_DOWNLOAD_JOBS=3
HAULARR_MAX_CONCURRENT_VERIFY_JOBS=2
HAULARR_MAX_CONCURRENT_EXTRACT_JOBS=1
HAULARR_MAX_CONCURRENT_PUBLISH_JOBS=1
HAULARR_MAX_CONCURRENT_IMPORT_JOBS=2
HAULARR_COMPLETED_HISTORY_DAYS=14
HAULARR_DISCOVERY_INTERVAL_SECONDS=30
HAULARR_RETRY_LIMIT=5
HAULARR_STAGE_LEASE_SECONDS=90
